# ── Local development ────────────────────────────────────────────────
# Docker Postgres (npm run db:up). Locally only DATABASE_URL is needed.
DATABASE_URL="postgresql://marginmap:marginmap@localhost:5432/marginmap?schema=public"

NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Session signing key. Production: 32+ random chars (openssl rand -base64 32).
AUTH_SECRET="dev-only-change-me-margin-map-secret-key"

# Shown on the login screen under "비밀번호를 잊었나요?" (optional).
NEXT_PUBLIC_SUPPORT_EMAIL=""

# Operator name shown in the privacy policy and terms (person or business name). Config, not secret.
NEXT_PUBLIC_OPERATOR_NAME=""

# ── Production (Vercel + Supabase) — set these in Vercel, not here ───
# DATABASE_URL: Supabase "Transaction pooler" string, port 6543, no sslmode param.
#   postgresql://postgres.<ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
# DIRECT_URL:   Supabase "Session pooler" string, port 5432, add ?sslmode=require (only prisma migrate uses it).
#   postgresql://postgres.<ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require
# DATABASE_CA_CERT (optional): Supabase SSL certificate (PEM, \n for newlines) to verify TLS.

# Search engine ownership checks (Google Search Console / Naver Search Advisor), optional.
# Paste only the content value of their <meta> tag. Plain (Config) vars, not secret.
GOOGLE_SITE_VERIFICATION=""
NAVER_SITE_VERIFICATION=""
